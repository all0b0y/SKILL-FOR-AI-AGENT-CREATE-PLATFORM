{
  "name": "agent-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "kb:ingest": "node --env-file-if-exists=.env.local --import tsx scripts/kb-ingest.ts",
    "retrieval:accept": "node --env-file-if-exists=.env.local --import tsx scripts/retrieval-accept.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "node --env-file-if-exists=.env.local --import tsx scripts/benchmark.ts",
    "architecture": "node scripts/architecture.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:e2e": "playwright test",
    "test:compose": "node scripts/compose-smoke.mjs",
    "test:references": "node scripts/reference-gate.mjs",
    "evals": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts",
    "evals:seed": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts seed",
    "evals:lint": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts lint",
    "evals:split": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts split",
    "evals:record": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts --mode record",
    "evals:live": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts --mode live",
    "model-bench": "node --env-file-if-exists=.env.local --import tsx src/evals/cli.ts bench",
    "af:build-gate": "node scripts/gate.mjs build",
    "af:evals-gate": "node scripts/gate.mjs evals",
    "af:ui-gate": "node scripts/gate.mjs ui",
    "worker:dev": "node --env-file-if-exists=.env.local --watch --import tsx src/worker.ts",
    "check-tools": "node --env-file-if-exists=.env.local --import tsx scripts/check-tools.ts",
    "cron": "node --env-file-if-exists=.env.local --import tsx scripts/cron.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/mcp": "2.0.65",
    "@ai-sdk/provider": "4.0.21",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "ai": "7.0.126",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "motion": "13.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "chrome-launcher": "1.2.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "knip": "6.39.0",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-compiler": "npm:typescript@6.0.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
