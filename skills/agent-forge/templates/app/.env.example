# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

# mock = scripted offline model (tests, e2e, first run). Otherwise a provider model id.
AF_MODEL=mock
# support | researcher | background; persisted per run, start a new conversation after changing.
AF_REFERENCE=support

# Offline by default. Semantic mode: text-embedding-3-small or text-embedding-3-large.
AF_EMBEDDING_MODEL=hash
AF_ALLOW_PAID_EMBEDDINGS=0
OPENAI_API_KEY=
# Verify the current provider price before setting a positive USD per million tokens.
AF_EMBEDDING_USD_PER_MILLION=
AF_EMBEDDING_INGEST_BUDGET_USD=0
AF_EMBEDDING_ACCEPT_BUDGET_USD=0
# Calibrate per embedding model with retrieval:accept; not a universal relevance guarantee.
AF_RETRIEVAL_MAX_DISTANCE=0.8
ANTHROPIC_API_KEY=

# Signs tool-approval requests so a client cannot forge an approval. 32+ random chars.
APPROVAL_SECRET=change-me-to-32-random-characters

# Identity seam: local (single user, binds 127.0.0.1) | trusted-header (behind your auth proxy).
IDENTITY_ADAPTER=local
IDENTITY_HEADER=x-user-id
IDENTITY_HEADER_SECRET=
HOST=127.0.0.1

# Optional OpenTelemetry/Langfuse export of trace metadata.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
