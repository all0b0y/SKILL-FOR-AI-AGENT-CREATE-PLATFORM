{
  "description": "agent-forge guards for Codex CLI. Copy to <project>/.codex/hooks.json and replace AGENT_FORGE_SKILL with the absolute path of the installed agent-forge skill directory.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node AGENT_FORGE_SKILL/scripts/hooks/hook.mjs phase-gate", "timeout": 10 },
          { "type": "command", "command": "node AGENT_FORGE_SKILL/scripts/hooks/hook.mjs destructive-guard", "timeout": 10 },
          { "type": "command", "command": "node AGENT_FORGE_SKILL/scripts/hooks/hook.mjs secret-guard", "timeout": 10 },
          { "type": "command", "command": "node AGENT_FORGE_SKILL/scripts/hooks/hook.mjs paid-call-guard", "timeout": 10 }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "node AGENT_FORGE_SKILL/scripts/hooks/hook.mjs phase-gate", "timeout": 10 },
          { "type": "command", "command": "node AGENT_FORGE_SKILL/scripts/hooks/hook.mjs secret-guard", "timeout": 10 }
        ]
      }
    ]
  }
}
